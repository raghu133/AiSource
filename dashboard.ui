  <property name="windowTitle">
   <string>AI Trainer Dashboard</string>
  </property>
  <property name="styleSheet">
   <string>
QWidget { font-size: 15px; background: #F8F5F0; color: #3E3A33; }
QPushButton {
  min-height: 25px;
  padding: 10px 18px;
  background: #CBBEA7;
  color: #2E2A25;
  border-radius: 12px;
}
QPushButton#btnClose { background: #D6A5A5; }
QPushButton#btnExit { background: #C78585; }
QPushButton#btnToggleCamera { background: #BFD1C6; }
QPushButton#btnSettings { background: #C6B3D6; }
QPushButton#btnRefresh { background: #B2D8D8; color: #1E3A3A; font-weight: bold; }
QPushButton#btnRefresh:hover { background: #9ECFCF; }
QPushButton#btnRefresh:pressed { background: #86C1C1; }
QPushButton#btnSearch { background: #C9D6C2; }
QPushButton#btnViewProducts { background: #C9D6C2; }
QPushButton#btnTrainSelected {
  background: #BFD3E6;
  color: #233345;
  border: 1px solid #A6BED4;
}
QPushButton#btnTrainSelected:hover {
  background: #AEC8DF;
}
QPushButton#btnTrainSelected:pressed {
  background: #9AB7D1;
}
QPushButton#btnBack { background: #B9B2A7; }
QPushButton#btnSaveSettings { min-height: 30px; padding: 10px 20px; }
QPushButton[active=&quot;true&quot;] { background: #E6D9C8; border: 2px solid #BDAF9A; }
QCheckBox::indicator {
  width: 20px;
  height: 20px;
  border: 2px solid #BDAF9A;
  border-radius: 4px;
  background: #FFFFFF;
}
QCheckBox::indicator:checked {
  background: #C6D6C2;
}
QLabel#lblScaleEnable, QLabel#lblCamEnabled, QLabel#lblDbEnabled {
  font-weight: 700;
}
QLabel#lblWeight { padding: 0 12px; background: #FFFFFF; border: 2px solid #E2D6C7; border-radius: 10px; font-size: 20px; font-weight: 700; }
QLabel#lblInventorySummary {
  padding: 0 12px;
  background: #FFFFFF;
  border: 2px solid #D9CFBF;
  border-radius: 10px;
  color: #4A433B;
  font-weight: 600;
}
QStackedWidget { border: 0px; }
QFormLayout { margin: 10px; spacing: 8px; }
QLabel { color: #4A433B; }
QCheckBox { spacing: 8px; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox { min-height: 35px; }
QListWidget#listSettingsNav {
  background: #F8F5F0;
  border: 0px;
}
QListWidget#listSettingsNav:focus { outline: none; }
QListWidget#listSettingsNav::item {
  min-height: 54px;
  margin: 6px;
  padding: 6px 10px;
  background: #CBBEA7;
  color: #2E2A25;
  border-radius: 10px;
}
QListWidget#listSettingsNav::item:selected {
  background: #E6D9C8;
}
QListWidget#listSettingsNav::item:selected:focus { outline: none; }
QLineEdit {
  min-height: 30px;
  padding: 8px 12px;
  border: 2px solid #D9CBB8;
  border-radius: 10px;
  background: #FFFFFF;
}
QComboBox, QSpinBox, QDoubleSpinBox {
  min-height: 30px;
  padding: 8px 12px;
  border: 2px solid #D9CBB8;
  border-radius: 10px;
  background: #FFFFFF;
  color: #3E3A33;
}
QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
  border: 2px solid #BDAF9A;
  outline: none;
}
QComboBox::drop-down {
  width: 26px;
  border-left: 1px solid #E2D6C7;
  background: transparent;
  border-top-right-radius: 8px;
  border-bottom-right-radius: 8px;
}
QComboBox::down-arrow {
  image: url(icons/arrow_down.svg);
  width: 10px;
  height: 10px;
}
QComboBox QAbstractItemView {
  background: #FFFFFF;
  border: 2px solid #E2D6C7;
  border-radius: 10px;
  padding: 6px;
  selection-background-color: #E6D9C8;
  selection-color: #2E2A25;
  outline: none;
  font-size: 15px;
}
QComboBox QAbstractItemView::item {
  min-height: 35px;
  padding: 6px 12px;
  border-radius: 8px;
  color: #3E3A33;
}
QComboBox QAbstractItemView::item:hover {
  background: #F0E6D8;
}
QComboBox QAbstractItemView::item:selected {
  background: #E6D9C8;
  color: #2E2A25;
}
QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
  width: 18px;
  border-left: 1px solid #E2D6C7;
  background: #F8F5F0;
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
  image: url(icons/arrow_up.svg);
  width: 8px;
  height: 8px;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
  image: url(icons/arrow_down.svg);
  width: 8px;
  height: 8px;
}
QSpinBox::up-button, QDoubleSpinBox::up-button {
  border-top-right-radius: 8px;
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
  border-bottom-right-radius: 8px;
}
QListWidget, QTableWidget {
  background: #FFFFFF;
  border: 2px solid #E2D6C7;
  border-radius: 10px;
}
QListWidget::item { min-height: 50px; }
QLabel#lblDashboardTitle { font-size: 20px; font-weight: bold; color: #5B5146; }
QListWidget#listTrainedData::item { min-height: 180px; }
QListWidget#listProducts::item {
  min-height: 140px;
  min-width: 180px;
  padding: 7px;
  margin: 7px;
  background: #FFF9F2;
  border: 2px solid #E6D9C8;
  border-radius: 14px;
}
QListWidget#listProducts::item:selected {
  background: #E6D9C8;
  border: 2px solid #BDAF9A;
}
QListWidget#listProducts, QListWidget#listMatches {
  padding: 2px;
}
QScrollBar:vertical {
  width: 30px;
  background: #FFFFFF;
  border: 1px solid #E3E7EE;
  border-radius: 6px;
  margin: 36px 0 36px 0;
}
QScrollBar::handle:vertical {
  background: #C7D0DC;
  min-height: 32px;
  border-radius: 6px;
}
QScrollBar::handle:vertical:hover {
  background: #B3BECC;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
  height: 30px;
  background: #FFFFFF;
  border: 1px solid #D7DEE8;
  border-radius: 15px;
}
QScrollBar::sub-line:vertical {
  subcontrol-origin: margin;
  subcontrol-position: top;
}
QScrollBar::add-line:vertical {
  subcontrol-origin: margin;
  subcontrol-position: bottom;
}
QScrollBar::up-arrow:vertical, QScrollBar::down-arrow:vertical {
  width: 12px;
  height: 12px;
}
QScrollBar::up-arrow:vertical {
  image: url(icons/arrow_up.svg);
}
QScrollBar::down-arrow:vertical {
  image: url(icons/arrow_down.svg);
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
  background: #FFFFFF;
}

